# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# For local MongoDB: mongodb://localhost:27017/youtube-watch-party
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/youtube-watch-party?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/youtube-watch-party

# CORS Configuration (Allowed frontend origin)
CLIENT_URL=http://localhost:5173
